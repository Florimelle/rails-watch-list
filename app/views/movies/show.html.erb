<div class="container my-5">
  <div class="card shadow">
    <div class="row g-0">
      <div class="col-md-4">
        <%= image_tag(@movie.poster_url.presence || "https://via.placeholder.com/300x450?text=No+Image", class: "img-fluid rounded-start", alt: movie.title) %>
      </div>

      <div class="col-md-8">
        <div class="card-body">
          <h2 class="card-title"><%= @movie.title %></h2>
          <p class="text-muted"><strong>Rating:</strong> <%= movie.rating %></p>
          <p class="card-text"><%= simple_format(@movie.overview) %></p>

          <%= link_to "Back to Movies", movies_path, class: "btn btn-secondary mt-3" %>
        </div>
      </div>
    </div>
  </div>
</div>
