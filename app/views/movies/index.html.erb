<h1 class="text-center my-4">All Movies</h1>

<div class="container mb-4 d-flex justify-content-between align-items-center">
  <h1 class="mb-0">All Movies</h1>
  <%= link_to "Add New Movie", new_movie_path, class: "btn btn-primary" %>
</div>

<div class="container">
  <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-4">
    <% @movies.each do |movie| %>
      <div class="col">
        <div class="card h-100 shadow-sm">
          <img
            src="<%= movie.poster_url.presence || 'https://via.placeholder.com/300x450?text=No+Image' %>"
            class="card-img-top"
            alt="<%= movie.title %> poster">

          <div class="card-body d-flex flex-column">
            <h5 class="card-title"><%= movie.title %></h5>
            <p class="mb-1 text-muted"><strong>⭐️ Rating:</strong> <%= movie.rating %></p>

            <p class="card-text mb-2">
              <%= truncate(movie.overview, length: 100, omission: '...') %>
            </p>

            <div class="mt-auto">
              <%= link_to "Delete", movie_path(movie), method: :delete, data: { confirm: "Are you sure you want to delete '#{movie.title}'?" }, class: "btn btn-sm btn-danger" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
