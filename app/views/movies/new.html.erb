<h1 class="my-4">Add a New Movie</h1>

<%= form_with model: @movie, local: true do |f| %>
    <div class="mb-3">
      <%= f.label :title, class: "form-label" %>
      <%= f.text_field :title, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :overview, class: "form-label" %>
      <%= f.text_area :overview, rows: 4, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :poster_url, class: "form-label" %>
      <%= f.url_field :poster_url, class: "form-control" %>
    </div>

    <div class="mb-3">
      <%= f.label :rating, class: "form-label" %>
      <%= f.number_field :rating, step: 0.1, class: "form-control" %>
    </div>

    <div class="text-center">
      <%= f.submit "Create Movie", class: "btn btn-success px-5" %>
    </div>
<% end %>
