<h1>New Movie</h1>

<br>
<%= form_with model: @movie do |f| %>
  <div>
    <%= f.label :title %><br>
    <%= f.text_field :title %>
  </div>

  <div>
    <%= f.label :overview %><br>
    <%= f.text_area :overview %>
  </div>

  <div>
    <%= f.label :poster_url %><br>
    <%= f.url_field :poster_url %>
  </div>

  <div>
      <%= f.label :rating %><br>
      <%= f.number_field :rating %><br>
    </div>

  <div><br>
    <%= f.submit "Add a movie" %><br>
  </div>
<% end %>
